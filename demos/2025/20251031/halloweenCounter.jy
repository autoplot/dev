from java.awt import FlowLayout
from javax.swing import JTextField,JButton,JPanel,JLabel
from java.lang import System

setScriptDescription('''Quick script to record times when Halloween 
trick-or-treaters arrive''')

def press(evt):
    t0= System.currentTimeMillis()
    print '%s,"%s",%s' % ( Units.ms1970.createDatum(t0), tf.text, count.text  )

def clear(evt):
    global tf
    tf.text=''

# TODO: prompts in text fields        
tf= JTextField(30);
tf.putClientProperty(
    "JTextField.placeholderText",
    "Favorite Costume"
);

count= JTextField(10);
count.putClientProperty(
    "JTextField.placeholderText",
    "Count"
);

butt= JButton("Best Creature",actionPerformed=press)
clrs= JButton("Clear",actionPerformed=clear)

p= JPanel()
p.layout= FlowLayout()
p.add(JLabel("Count:"))
p.add(count)
p.add(JLabel("Best Costume:"))
p.add(tf)
p.add(clrs)
p.add(butt)

getApplication().setBottomPanel(p)
