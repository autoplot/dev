# Asteroids JPanel edition for Autoplot - Jython 2.2 compatible
# Run in Autoplot's script editor; embed AsteroidsPanel in a JTabbedPane.
# LEFT/RIGHT rotate, UP thrust, SPACE fire, P pause, R restart.
# Original vector arcade game; no external images or libraries.
from javax.swing import Timer, JPanel, JFrame, JTabbedPane, SwingUtilities
from java.awt import Color, Font, BasicStroke, RenderingHints
from java.awt.event import KeyAdapter, KeyEvent, ActionListener, MouseAdapter
import math
import random

WIDTH = 800.0
HEIGHT = 600.0
TWOPI = 2.0 * math.pi


def wrap(v, limit):
    return v % limit


def torus_delta(a, b, limit):
    d = abs(a - b)
    if d > limit / 2.0:
        d = limit - d
    return d


def near(x1, y1, x2, y2, radius):
    dx = torus_delta(x1, x2, WIDTH)
    dy = torus_delta(y1, y2, HEIGHT)
    return dx * dx + dy * dy < radius * radius


class GameKeys(KeyAdapter):
    def __init__(self, game):
        self.game = game

    def keyPressed(self, event):
        k = event.getKeyCode()
        was_down = self.game.keys.has_key(k)
        self.game.keys[k] = 1
        if not was_down:
            if k == KeyEvent.VK_R:
                self.game.reset()
            elif k == KeyEvent.VK_P:
                if self.game.state == 'playing':
                    self.game.state = 'paused'
                elif self.game.state == 'paused':
                    self.game.state = 'playing'
            elif k == KeyEvent.VK_SPACE:
                if self.game.state == 'playing':
                    self.game.fire()
        event.consume()

    def keyReleased(self, event):
        k = event.getKeyCode()
        if self.game.keys.has_key(k):
            del self.game.keys[k]
        event.consume()


class GameTick(ActionListener):
    def __init__(self, game):
        self.game = game

    def actionPerformed(self, event):
        self.game.tick()
        self.game.canvas.repaint()


class AsteroidsGame(object):
    def __init__(self, canvas):
        self.canvas = canvas
        self.keys = {}
        self.reset()
        self.key_listener = GameKeys(self)
        canvas.addKeyListener(self.key_listener)
        canvas.setFocusable(True)
        self.timer = Timer(33, GameTick(self))
        # The panel starts/stops this timer as it enters/leaves the UI.

    def reset(self):
        self.score = 0
        self.lives = 3
        self.wave = 1
        self.state = 'playing'
        self.keys = {}
        self.bullets = []
        self.particles = []
        self.cooldown = 0
        self.respawn()
        self.new_wave()

    def respawn(self):
        self.x = WIDTH / 2.0
        self.y = HEIGHT / 2.0
        self.vx = 0.0
        self.vy = 0.0
        self.angle = -math.pi / 2.0
        self.safe = 90

    def new_wave(self):
        self.rocks = []
        count = min(4 + self.wave, 12)
        for i in range(count):
            for attempt in range(60):
                x = random.random() * WIDTH
                y = random.random() * HEIGHT
                if not near(x, y, self.x, self.y, 145.0):
                    break
            self.add_rock(x, y, 3)
        self.safe = max(self.safe, 70)

    def add_rock(self, x, y, size):
        direction = random.random() * TWOPI
        speed = (0.8 + random.random() * 0.9 + 0.12 * self.wave) * (4 - size) * 0.7
        radius = 13.0 * size
        points = []
        for i in range(11):
            a = TWOPI * i / 11.0
            r = radius * (0.68 + 0.32 * random.random())
            points.append((math.cos(a) * r, math.sin(a) * r))
        self.rocks.append([x, y, math.cos(direction)*speed,
                           math.sin(direction)*speed, size, points,
                           random.random()*TWOPI, (random.random()-0.5)*0.05])

    def fire(self):
        if self.cooldown > 0 or len(self.bullets) >= 6:
            return
        ca = math.cos(self.angle)
        sa = math.sin(self.angle)
        self.bullets.append([wrap(self.x+ca*17, WIDTH),
                             wrap(self.y+sa*17, HEIGHT),
                             self.vx+ca*9.5, self.vy+sa*9.5, 44])
        self.cooldown = 6

    def sparks(self, x, y, count, color):
        for i in range(count):
            a = random.random() * TWOPI
            v = 0.6 + random.random() * 3.8
            self.particles.append([x, y, math.cos(a)*v, math.sin(a)*v,
                                   10 + random.randint(0, 16), color])

    def hit_ship(self):
        self.sparks(self.x, self.y, 24, Color(120, 230, 255))
        self.lives -= 1
        if self.lives <= 0:
            self.state = 'gameover'
        else:
            self.respawn()

    def tick(self):
        if self.state != 'playing':
            return
        if self.cooldown > 0:
            self.cooldown -= 1
        if self.safe > 0:
            self.safe -= 1
        if self.keys.has_key(KeyEvent.VK_LEFT):
            self.angle -= 0.095
        if self.keys.has_key(KeyEvent.VK_RIGHT):
            self.angle += 0.095
        if self.keys.has_key(KeyEvent.VK_UP):
            self.vx += math.cos(self.angle) * 0.18
            self.vy += math.sin(self.angle) * 0.18
            if random.random() < 0.7:
                self.particles.append([self.x-math.cos(self.angle)*13,
                                       self.y-math.sin(self.angle)*13,
                                       self.vx-math.cos(self.angle)*2.5,
                                       self.vy-math.sin(self.angle)*2.5,
                                       7, Color(255, 165, 60)])
        if self.keys.has_key(KeyEvent.VK_SPACE):
            self.fire()
        speed = math.sqrt(self.vx*self.vx+self.vy*self.vy)
        if speed > 7.0:
            self.vx *= 7.0/speed
            self.vy *= 7.0/speed
        self.vx *= 0.998
        self.vy *= 0.998
        self.x = wrap(self.x + self.vx, WIDTH)
        self.y = wrap(self.y + self.vy, HEIGHT)

        for rock in self.rocks:
            rock[0] = wrap(rock[0]+rock[2], WIDTH)
            rock[1] = wrap(rock[1]+rock[3], HEIGHT)
            rock[6] += rock[7]
        for bullet in self.bullets[:]:
            bullet[0] = wrap(bullet[0]+bullet[2], WIDTH)
            bullet[1] = wrap(bullet[1]+bullet[3], HEIGHT)
            bullet[4] -= 1
            if bullet[4] <= 0:
                self.bullets.remove(bullet)
                continue
            for rock in self.rocks[:]:
                if near(bullet[0], bullet[1], rock[0], rock[1], 12.0*rock[4]):
                    self.bullets.remove(bullet)
                    self.rocks.remove(rock)
                    self.score += (4-rock[4])*25
                    self.sparks(rock[0], rock[1], 8, Color(225, 230, 245))
                    if rock[4] > 1:
                        for i in range(2):
                            self.add_rock(rock[0], rock[1], rock[4]-1)
                    break
        if self.safe == 0:
            for rock in self.rocks:
                if near(self.x, self.y, rock[0], rock[1], 11.0+11.0*rock[4]):
                    self.hit_ship()
                    break
        for particle in self.particles[:]:
            particle[0] = wrap(particle[0]+particle[2], WIDTH)
            particle[1] = wrap(particle[1]+particle[3], HEIGHT)
            particle[4] -= 1
            if particle[4] <= 0:
                self.particles.remove(particle)
        if len(self.rocks) == 0:
            self.wave += 1
            self.new_wave()

    def paint(self, graphics):
        if self.canvas.getWidth() <= 0 or self.canvas.getHeight() <= 0:
            return
        g = graphics.create()
        try:
            g.setColor(Color(6, 12, 24))
            g.fillRect(0, 0, self.canvas.getWidth(), self.canvas.getHeight())
            g.scale(self.canvas.getWidth()/WIDTH, self.canvas.getHeight()/HEIGHT)
            g.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                               RenderingHints.VALUE_ANTIALIAS_ON)
            g.setStroke(BasicStroke(2.0))
            g.setColor(Color(62, 78, 105))
            for i in range(40):
                sx = (i * 197 + 73) % 800
                sy = (i * 113 + 41) % 600
                g.fillOval(sx, sy, 2, 2)
            for rock in self.rocks:
                self.draw_rock(g, rock)
            g.setColor(Color(255, 230, 120))
            for bullet in self.bullets:
                g.fillOval(int(bullet[0])-2, int(bullet[1])-2, 5, 5)
            for particle in self.particles:
                g.setColor(particle[5])
                g.fillOval(int(particle[0]), int(particle[1]), 3, 3)
            if self.state != 'gameover':
                if self.safe == 0 or (self.safe / 5) % 2 == 0:
                    self.draw_ship(g)
            g.setColor(Color(180, 235, 255))
            g.setFont(Font('Monospaced', Font.BOLD, 20))
            g.drawString('SCORE %06d' % self.score, 18, 30)
            g.drawString('LIVES %d' % self.lives, 340, 30)
            g.drawString('WAVE %d' % self.wave, 645, 30)
            g.setFont(Font('SansSerif', Font.PLAIN, 14))
            g.drawString('LEFT/RIGHT rotate   UP thrust   SPACE fire   P pause   R restart', 18, 578)
            if self.state != 'playing':
                g.setColor(Color(0, 0, 0, 185))
                g.fillRect(0, 0, int(WIDTH), int(HEIGHT))
                g.setColor(Color(245, 245, 255))
                g.setFont(Font('SansSerif', Font.BOLD, 46))
                if self.state == 'paused':
                    g.drawString('PAUSED', 308, 280)
                    msg = 'Press P to continue'
                else:
                    g.drawString('GAME OVER', 250, 280)
                    msg = 'Press R to restart'
                g.setFont(Font('SansSerif', Font.PLAIN, 22))
                g.drawString(msg, 295, 325)
        finally:
            g.dispose()

    def draw_ship(self, g):
        # Drawing in local coordinates keeps rotation simple.
        s = g.create()
        try:
            s.translate(self.x, self.y)
            s.rotate(self.angle)
            s.setColor(Color(115, 230, 255))
            xs = [18, -13, -7, -13]
            ys = [0, -11, 0, 11]
            s.drawPolygon(xs, ys, 4)
            if self.keys.has_key(KeyEvent.VK_UP) and self.state == 'playing':
                s.setColor(Color(255, 170, 65))
                s.drawLine(-12, -5, -23-random.randint(0, 9), 0)
                s.drawLine(-23-random.randint(0, 9), 0, -12, 5)
        finally:
            s.dispose()

    def draw_rock(self, g, rock):
        s = g.create()
        try:
            s.translate(rock[0], rock[1])
            s.rotate(rock[6])
            s.setColor(Color(190, 203, 225))
            xs = []
            ys = []
            for point in rock[5]:
                xs.append(int(point[0]))
                ys.append(int(point[1]))
            s.drawPolygon(xs, ys, len(xs))
        finally:
            s.dispose()


class FocusMouse(MouseAdapter):
    def __init__(self, panel):
        self.panel = panel

    def mousePressed(self, event):
        self.panel.requestFocusInWindow()


class AsteroidsPanel(JPanel):
    """Embeddable Swing component; add it to any JTabbedPane."""
    def __init__(self):
        JPanel.__init__(self)
        self.setFocusable(True)
        self.setBackground(Color(6, 12, 24))
        self.game = AsteroidsGame(self)
        self.addMouseListener(FocusMouse(self))

    def paintComponent(self, graphics):
        graphics.setColor(self.getBackground())
        graphics.fillRect(0, 0, self.getWidth(), self.getHeight())
        self.game.paint(graphics)

    def addNotify(self):
        JPanel.addNotify(self)
        self.game.timer.start()

    def removeNotify(self):
        self.game.timer.stop()
        self.game.keys.clear()
        JPanel.removeNotify(self)

    def stop(self):
        self.game.timer.stop()
        self.game.keys.clear()


# Embed in an existing JTabbedPane with:
#     panel = AsteroidsPanel()
#     tabs.addTab('Asteroids', panel)
#     tabs.setSelectedComponent(panel)
#     panel.requestFocusInWindow()
#
# When the tab is removed, removeNotify() stops the timer.
# To stop the game explicitly, call panel.stop().
#
# Standalone demonstration (set SHOW_DEMO = False if embedding elsewhere).
SHOW_DEMO = True

panel = AsteroidsPanel()
addTab('Asteroids', panel)
panel.requestFocusInWindow()
print('Asteroids panel: click the tab to focus; arrows, SPACE, P, R.')
