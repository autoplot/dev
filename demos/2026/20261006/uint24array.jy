import jarray

print 'little endian'
buf= jarray.zeros(12,"b")
buf[0]= -127
buf[2]= 1
buf[5]= 1
buf[8]= 1
buf[9]= 1

from java.nio import ByteBuffer, ByteOrder
buffy= ByteBuffer.wrap(buf)
buffy.order(ByteOrder.LITTLE_ENDIAN)

from org.autoplot.bufferdataset import Int24DataSet
ds1= Int24DataSet(1,3,0,4,1,1,1,buffy)

for i in xrange(ds1.length()):
    print ds1.value(i)

print 'big endian'
buf= jarray.zeros(12,"b")
buf[0]= 1
buf[2]= -127
buf[3]= 1
buf[6]= 1
buf[11]= 1

buffy= ByteBuffer.wrap(buf)
buffy.order(ByteOrder.BIG_ENDIAN)

from org.autoplot.bufferdataset import Int24DataSet
ds1= Int24DataSet(1,3,0,4,1,1,1,buffy)

for i in xrange(ds1.length()):
    print ds1.value(i)
    
import jarray

print 'uint24 little endian'
buf= jarray.zeros(12,"b")
buf[0]= -127
buf[2]= 1
buf[5]= 1
buf[8]= 1
buf[9]= 1

from java.nio import ByteBuffer, ByteOrder
buffy= ByteBuffer.wrap(buf)
buffy.order(ByteOrder.LITTLE_ENDIAN)

from org.autoplot.bufferdataset import UInt24DataSet
ds1= UInt24DataSet(1,3,0,4,1,1,1,buffy)

for i in xrange(ds1.length()):
    print ds1.value(i)

print 'uint24 big endian'
