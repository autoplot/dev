from org.das2.util.ColorUtil import decodeColor
from java.awt import Color

setScriptDescription('''2019 code to demo color parameters.  This was not well-tested and was
never completed, as shown here.  Note that changing one of the color parameters results
in a runtime error.''')

color1= getParam( 'color1', Color.RED )
color2= getParam( 'color2', Color.RED, 'line color', [ Color.BLUE, Color.RED, decodeColor('saddlebrown') ] )
sides= getParam( 'sides', 4, 'number of sides', { 'values':[ 3,4,6], 'labels':['triangle','square','hexagon'] } )

print params

from org.das2.graph import Painter
from java.awt.geom import GeneralPath
class MyPainter( Painter ):
    def paint( self, g ):
        gp= GeneralPath()
        cx= 100
        cy= 100
        r= 50
        
        gp.moveTo( cx+r, cy )
        for i in xrange(1,sides+1):
            gp.lineTo( cx + r * cos( TAU * i / sides ), cy - r * sin( TAU * i / sides ) )
        
        g.color= color1
        g.fill( gp )
        g.color= color2
        g.draw( gp )

dom.canvases[0].controller.dasCanvas.addTopDecorator(MyPainter())
