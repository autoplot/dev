from java.util import HashMap
from java.io import File
from org.das2.util import FileUtil,AboutUtil
from org.autoplot.jythonsupport import JythonUtil

setScriptTitle('count params')
setScriptDescription('''Count the number of script parameters found and then print the script name and 
number of parameters.  This will be run with new and old versions of Autoplot
to verify the new parsing doesn't loose parameters.''')

scriptfile= getParam('script','nparamsTest.jy','Script (no path)',{'examples':['cornerCases.jy','cornerCase2.jy']})
vers = AboutUtil.getReleaseTag()
if vers=='(dev)': vers='dev'

if scriptfile.find('/')==-1:
    scriptfile= PWD + scriptfile

if ( scriptfile.startswith('/') ):
    scriptfile= 'file:'+scriptfile
    
script = FileUtil.readFileToString(File(URI(scriptfile).getPath()))

env= HashMap()
env.put('PWD',URL(scriptfile).path)

pp= JythonUtil.describeScript(env,script,None)

i= scriptfile.rfind('/')
nn= scriptfile[i+1:-3]

i2= scriptfile.rfind('/dev/')
if i2==-1:
    nn2= scriptfile[i+1]
else:
    nn2= scriptfile[i2+1:]

print 'mkdir '+PWD + 'output-%s/' % vers
mkdir(PWD + 'output-%s/' % vers )
o=open(URL(PWD + 'output-%s/%s.txt' % (vers,nn) ).path,'w')
o.write( '%s %d\n' % ( nn2, pp.getParams().size() ) )
o.close()

