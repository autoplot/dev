from org.das2.util import FileUtil
from org.autoplot.jythonsupport import JythonAstFormatter

scriptfile= getParam('script','cornerCase2.jy','Script (no path)',{'examples':['cornerCases.jy','cornerCase2.jy']})

if scriptfile.find('/')==-1:
    scriptfile= PWD + scriptfile
    
import org.python.core.parser.parse
script= FileUtil.readFileToString( getFile( scriptfile ) )
n = org.python.core.parser.parse(script, "exec")

print JythonAstFormatter.format(n)
